# ==============================================================================
# Criminal Network Analysis System — Environment Configuration
# Reference: DOC2 §15, DOC3 §2.1, DOC3 §2.6
# ==============================================================================

# Application execution environment: "development", "production", or "test".
# In non-development modes, required secrets and connection parameters are strictly enforced.
ENVIRONMENT=development

# Default dataset scope for all read operations ("synthetic_demo" | "live_public").
# Defaults to "synthetic_demo" to prevent accidental data contamination (DOC3 §2.6).
DEFAULT_DATASET=synthetic_demo

# Feature flag controlling whether live polling adapters are enabled.
# Defaults to false so the guaranteed demo runs completely offline (DOC2 §6.5, DOC3 Invariant 7).
LIVE_ADAPTER_ENABLED=false

# ------------------------------------------------------------------------------
# Neo4j Database Connection
# ------------------------------------------------------------------------------
# URI for Neo4j Aura or local instance (e.g., bolt://localhost:7687 or neo4j+s://xxx.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687

# Username for Neo4j authentication
NEO4J_USER=neo4j

# Password for Neo4j authentication
NEO4J_PASSWORD=password

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# LLM provider implementation behind the LLMClient interface (e.g., "mock", "openai", "gemini", "anthropic")
# Defaults to "mock" for local/offline testing without external API calls (DOC3 §14).
LLM_PROVIDER=mock

# API key for the chosen LLM provider (not required when LLM_PROVIDER is "mock")
LLM_API_KEY=
