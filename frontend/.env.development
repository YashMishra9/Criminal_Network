# Development defaults — loaded automatically by Next.js for `npm run dev`.
# Mock mode is ON by default so the frontend runs standalone without a backend or Neo4j.
# To use a real backend locally, set NEXT_PUBLIC_MOCK_MODE=false and configure the URL below.
NEXT_PUBLIC_MOCK_MODE=true
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
